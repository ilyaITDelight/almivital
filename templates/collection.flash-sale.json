an><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Nur solange der Vorrat reicht</span><span data-until=\"end\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Versandkostenfrei bis 12 Uhr</span><span data-until=\"end\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Live mit Felix Neumann ab 11 Uhr</span><span data-until=\"sale\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Nur bis 29.11. um 23:59 Uhr</span><span><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Bis zu 50 % Rabatt</span><span><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Nur solange der Vorrat reicht</span><span data-until=\"end\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Versandkostenfrei bis 12 Uhr</span><span data-until=\"end\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Live mit Felix Neumann ab 11 Uhr</span><span data-until=\"sale\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Nur bis 29.11. um 23:59 Uhr</span><span><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Bis zu 50 % Rabatt</span><span><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Nur solange der Vorrat reicht</span><span data-until=\"end\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Versandkostenfrei bis 12 Uhr</span><span data-until=\"end\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Live mit Felix Neumann ab 11 Uhr</span><span data-until=\"sale\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><use href=\"#avb\"/></svg>Nur bis 29.11. um 23:59 Uhr</span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\nvar START = Date.UTC(2026, 10, 22, 8, 0, 0);   // So 22.11.2026, 9:00 Uhr Berliner Zeit\nvar LIVE  = Date.UTC(2026, 10, 22, 10, 0, 0);  // 11:00 Uhr Live Stream\nvar END   = Date.UTC(2026, 10, 22, 11, 0, 0);  // 12:00 Uhr Ende Live Stream & Versandkostenfreiheit\nvar SALE_END = Date.UTC(2026, 10, 29, 23, 0, 0); // Ende Flash Sale: So 29.11.2026, 23:59 Uhr (Countdown läuft bis 24:00)\nvar q = /[?&]fsnow=(\\d+)/.exec(location.search); // Test: ?fsnow=1795341600000 (= 22.11. 11:00 Uhr) (Zeitstempel in ms)\nvar shift = q ? parseInt(q[1], 10) - new Date().getTime() : 0;\n\nvar root = document.getElementById('av-fs'); if (!root) return;\nvar panel = document.getElementById('av-fs-panel');\nvar badge = document.getElementById('av-fs-badge');\nvar title = document.getElementById('av-fs-title');\nvar sub = document.getElementById('av-fs-sub');\nvar cd = document.getElementById('av-fs-cd');\nvar uD = document.getElementById('av-fs-u-d');\nvar els = {}, last = {}, nums = root.querySelectorAll('.av-fs__num');\nfor (var i = 0; i < nums.length; i++) els[nums[i].getAttribute('data-k')] = nums[i];\nvar state = '';\nfunction pad(n){ return n < 10 ? '0' + n : '' + n; }\nfunction set(k, v){ if (last[k] === v) return; last[k] = v; var el = els[k]; el.textContent = v; el.className = 'av-fs__num'; void el.offsetWidth; el.className = 'av-fs__num tick'; }\nfunction show(target){\nvar s = Math.max(0, Math.ceil((target - (new Date().getTime() + shift)) / 1000));\nvar d = Math.floor(s / 86400);\nuD.style.display = d > 0 ? '' : 'none';\nset('d', '' + d); set('h', pad(Math.floor(s % 86400 / 3600))); set('m', pad(Math.floor(s % 3600 / 60))); set('s', pad(s % 60));\nreturn s;\n}\nfunction render(){\nvar now = new Date().getTime() + shift, st;\nif (now < START) st = 'soon'; else if (now < END) st = (now < LIVE ? 'vip' : 'live'); else st = (now < SALE_END ? 'week' : 'after');\nif (st !== state) {\nstate = st;\ncd.style.display = st === 'after' ? 'none' : '';\nif (st === 'soon') { badge.textContent = 'Flash Sale Week'; title.innerHTML = 'Bis zu <b>50&nbsp;% Rabatt</b> – der Flash Sale startet in'; sub.innerHTML = '<b>Sonntag, 22.11. ab 9:00 Uhr</b> · Live Stream mit Felix Neumann ab 11:00 Uhr'; }\nif (st === 'vip')  { badge.textContent = 'Jetzt gestartet'; title.innerHTML = 'Versandkostenfrei bestellen – <b>nur noch</b>'; sub.innerHTML = 'Live Stream mit Felix Neumann ab <b>11:00 Uhr</b> · nur solange der Vorrat reicht'; }\nif (st === 'live') { badge.textContent = 'Jetzt live'; title.innerHTML = 'Live Stream &amp; Versandkostenfreiheit <b>enden in</b>'; sub.innerHTML = 'Bis zu <b>50&nbsp;% Rabatt</b> · nur solange der Vorrat reicht'; }\nif (st === 'week') { badge.textContent = 'Flash Sale Week'; title.innerHTML = 'Bis zu <b>50&nbsp;% Rabatt</b> – der Flash Sale endet in'; sub.innerHTML = '<b>Nur bis Sonntag, 29.11. um 23:59 Uhr</b> · solange der Vorrat reicht'; }\nif (st === 'after'){ badge.textContent = 'Flash Sale Week'; title.innerHTML = 'Der Flash Sale ist beendet'; sub.innerHTML = 'Vielen Dank für Ihr Interesse!'; }\n}\n// pinke Zahlen: bis 12 Uhr (Versandkostenfreiheit) und in den letzten 24 Stunden des Sales\nvar hot = st === 'vip' || st === 'live' || (st === 'week' && SALE_END - now <= 86400000);\nvar pc = 'av-fs__panel' + (hot ? ' av-fs__final' : '');\nif (panel.className !== pc) panel.className = pc;\nif (st === 'soon') show(START); else if (st === 'vip' || st === 'live') show(END); else if (st === 'week') show(SALE_END);\n}\nvar tick = root.querySelectorAll('[data-until]');\nfunction ticker(){\nvar now = new Date().getTime() + shift;\nfor (var t = 0; t < tick.length; t++) {\nvar k = tick[t].getAttribute('data-until'), u = k === 'end' ? END : (k === 'sale' ? SALE_END : START);\ntick[t].style.display = now >= u ? 'none' : '';\n}\n}\nticker(); setInterval(ticker, 60000);\nrender(); setInterval(render, 500);\n})();\n</script>\n<script type=\"application/json\" id=\"av-fs-stock\">{ {%- for p in collection.products -%}{%- assign q = 0 -%}{%- assign t = true -%}{%- for v in p.variants -%}{%- if v.inventory_management != 'shopify' or v.inventory_policy == 'continue' -%}{%- assign t = false -%}{%- elsif v.inventory_quantity > 0 -%}{%- assign q = q | plus: v.inventory_quantity -%}{%- endif -%}{%- endfor -%}{%- if t -%}{{ p.handle | json }}:{{ q }},{%- endif -%}{%- endfor -%}\"_\":0}</script>\n<script>\n(function(){\nvar LIMIT = 20; // ab diesem Bestand (und darunter) wird \"Nur noch X Stück\" angezeigt\nvar el = document.getElementById('av-fs-stock'), map = {};\ntry { map = JSON.parse(el.textContent); } catch (e) { return; }\nfunction apply(){\nvar cards = document.querySelectorAll('.card-wrapper');\nfor (var i = 0; i < cards.length; i++) {\nvar c = cards[i]; if (c.querySelector('.av-stock')) continue;\nvar a = c.querySelector('a[href*=\"/products/\"]'); if (!a) continue;\nvar m = /\\/products\\/([^\\/?#]+)/.exec(a.getAttribute('href')); if (!m) continue;\nvar q = map[decodeURIComponent(m[1])];\nif (typeof q !== 'number' || q < 1 || q > LIMIT) continue;\nvar d = document.createElement('div');\nd.className = 'av-stock' + (q <= 5 ? ' av-stock--low' : '');\nd.innerHTML = '<div class=\"av-stock__txt\"><span class=\"av-stock__dot\"></span>Nur noch ' + q + ' Stück!</div><div class=\"av-stock__bar\"><i style=\"width:' + Math.max(8, Math.round(q / LIMIT * 100)) + '%\"></i></div>';\nvar pr = c.querySelector('.card-information .price');\nif (pr && pr.parentNode) pr.parentNode.insertBefore(d, pr.nextSibling);\nelse { var w = c.querySelector('.card-information'); if (w) w.appendChild(d); }\n}\n}\napply();\nvar t, hero = document.getElementById('av-fs');\nnew MutationObserver(function(ms){\nfor (var i = 0; i < ms.length; i++) if (!(hero && hero.contains(ms[i].target)) && !(ms[i].target.closest && ms[i].target.closest('.av-stock'))) { clearTimeout(t); t = setTimeout(apply, 150); return; }\n}).observe(document.body, {childList: true, subtree: true});\n})();\n</script>",
