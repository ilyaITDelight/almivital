          "settings": {
            "heading": "Natürliche Inhaltsstoffe und höchste Qualität",
            "heading_size": "h1",
            "heading_tag": "h2"
          }
        },
        "text_mk7kmY": {
          "type": "text",
          "settings": {
            "text": "<p>Unsere Produktpalette setzt auf bewährte Heilpflanzen wie <strong>Teufelskralle</strong>, <strong>Heilmoor</strong>, <strong>rotes Weinlaub</strong> und <strong>Hyaluron</strong>, die für ihre positiven Effekte auf Haut, Muskeln und Faszien bekannt sind. ALMIVITAL-Produkte werden in unserem eigenen Labor entwickelt, wo höchste Sorgfalt und modernste Technologien zum Einsatz kommen. Wir legen großen Wert darauf, dass alle unsere Produkte in Deutschland hergestellt und nach den strengsten Qualitätsstandards geprüft werden. <strong>Dermatologisch getestet</strong> und frei von belastenden Inhaltsstoffen wie Parabenen und Silikonen, bieten unsere Produkte sichere Pflege für jeden Tag.</p>",
            "text_size": "typeset2",
            "secondary_color": false
          }
        }
